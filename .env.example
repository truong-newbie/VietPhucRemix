# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - VIỆT PHỤC REMIX v2
# Lưu ý:
# - KHÔNG commit file .env lên Git (đã được .gitignore bảo vệ).
# - Khi chưa điền key, ứng dụng vẫn chạy đầy đủ ở chế độ Offline / LocalStorage.
# ==============================================================================

# --- 1. SERVER-ONLY SECRETS (Vercel Serverless / Local Dev Middleware) ---
# Khóa API Gemini từ Google AI Studio (dùng cho RAG Cố vấn & AI Virtual Try-On)
GEMINI_API_KEY=

# (Tùy chọn) Khóa Fal.ai nếu chuyển TRYON_PROVIDER=fal
FAL_KEY=

# Chọn nhà cung cấp AI thử đồ: gemini | fal
TRYON_PROVIDER=gemini

# Mật khẩu ưu tiên mở khóa không giới hạn lượt thử AI cho Ban Giám khảo / Admin
JUDGE_PASSCODE=

# Khóa Service Role của Supabase (chỉ dùng phía server nếu cần thao tác admin)
SUPABASE_SERVICE_ROLE_KEY=

# --- 2. CLIENT-SAFE PUBLIC CONFIG (Vite expose ra trình duyệt) ---
# URL & Anon Key của project Supabase (lấy trong Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Danh sách email Cố vấn văn hóa được phép vào trang duyệt luật (?admin=1), cách nhau dấu phẩy
VITE_ADMIN_EMAILS=
